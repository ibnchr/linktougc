# Google Gemini API Key (wajib)
# Dapatkan di: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Veo API Key (opsional, fallback ke GEMINI_API_KEY)
VEO_API_KEY=your_veo_api_key_here

# Mock mode untuk Veo (set true jika tidak punya akses Veo)
# VEO_MOCK=true

# Uploadthing Token (untuk upload gambar/video)
# Dapatkan di: https://uploadthing.com
# UPLOADTHING_TOKEN=your_uploadthing_token_here
